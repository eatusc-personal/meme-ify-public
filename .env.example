# Required for durable state. The schema is applied idempotently on startup.
DATABASE_URL=postgresql://localhost:5432/meme_ify

# Optional paid/free-tier search providers used for social-chatter checks.
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# Optional market-data integrations.
COINGECKO_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=

# Optional local Claude CLI review. Disabled unless explicitly enabled.
ENABLE_LOCAL_CLAUDE=false

# Background work is off by default. Enable only after reviewing the docs.
SERVER_SCHEDULER_WATCH=false
SERVER_SCHEDULER_SCAN=false
SCAN_INTERVAL_MIN=15
NEWCOIN_BANDS=A
NEWCOIN_MIN_LIQUIDITY_USD=50000
NEWCOIN_MIN_VOLUME_24H=75000
NEWCOIN_MAX_ALERTS_PER_SCAN=5
NEWCOIN_RUGCHECK=true
NEWCOIN_REQUIRE_EXITABLE=true
NEWCOIN_REALERT_RATING_POINTS=10
NEWCOIN_REALERT_MOVE_PCT=40
